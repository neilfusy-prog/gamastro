<!DOCTYPE html>

<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IA Astronomie</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #050816;
      color: white;
    }

```
.container {
  max-width: 800px;
  margin: auto;
  padding: 30px 20px;
}

h1 {
  text-align: center;
  color: #7dd3fc;
}

#chat {
  height: 500px;
  overflow-y: auto;
  padding: 15px;
  background: #0b1025;
  border-radius: 15px;
  margin-bottom: 15px;
}

.message {
  padding: 12px;
  margin: 10px 0;
  border-radius: 12px;
}

.user {
  background: #1d4ed8;
  text-align: right;
}

.ia {
  background: #172033;
}

.input-zone {
  display: flex;
  gap: 10px;
}

input {
  flex: 1;
  padding: 14px;
  border: none;
  border-radius: 10px;
  font-size: 16px;
}

button {
  padding: 14px 20px;
  border: none;
  border-radius: 10px;
  background: #38bdf8;
  cursor: pointer;
  font-weight: bold;
}
```

  </style>
</head>

<body>

<div class="container">

  <h1>🔭 AstroIA</h1>

  <div id="chat">
    <div class="message ia">
      Bonjour ! Je suis AstroIA. Pose-moi une question sur l'astronomie.
    </div>
  </div>

  <div class="input-zone">
    <input
      id="question"
      type="text"
      placeholder="Pose ta question..."
    >

```
<button onclick="envoyerQuestion()">
  Envoyer
</button>
```

  </div>

</div>

<script>

async function envoyerQuestion() {

  const input = document.getElementById("question");
  const chat = document.getElementById("chat");

  const question = input.value.trim();

  if (!question) return;

  chat.innerHTML += `
    <div class="message user">
      ${question}
    </div>
  `;

  input.value = "";

  chat.innerHTML += `
    <div class="message ia" id="chargement">
      AstroIA réfléchit...
    </div>
  `;

  /*
    L'appel à l'IA sera ajouté ici.
    IMPORTANT :
    on ne mettra pas la clé API directement
    dans ce fichier public.
  */

}

</script>

</body>
</html>
